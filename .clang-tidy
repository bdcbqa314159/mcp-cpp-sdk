# Modest, low-noise set. Zed's clangd runs these inline while you type.
# Turned off the checks that fight a small, readable SDK more than they help.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-braces-around-statements
HeaderFilterRegex: 'include/mcp/.*'
WarningsAsErrors: ''
